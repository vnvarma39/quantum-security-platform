# ─────────────────────────────────────────────────────────────
# QSIP Environment Configuration
# Copy to .env and fill in your values — never commit .env
# ─────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────
APP_ENV=development                     # development | production
DEBUG=true
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Quantum Backend ───────────────────────────────────────────
QSIP_QUANTUM_BACKEND=simulator          # simulator | ibm_quantum | aws_braket
QSIP_QUBITS=16
QSIP_ANNEALING_STEPS=2000
QSIP_ANNEALING_TEMP_START=100.0
QSIP_ANNEALING_TEMP_END=0.01
QSIP_TUNNELING_STRENGTH=0.15
QSIP_QAOA_REPS=2
QSIP_WALK_STEPS=10
QSIP_WALK_SHOTS=4096

# ── IBM Quantum (leave blank if using simulator) ──────────────
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=ibm-q/open/main
IBM_QUANTUM_CHANNEL=ibm_quantum

# ── AWS Braket (leave blank if using simulator) ───────────────
AWS_BRAKET_REGION=us-east-1
AWS_BRAKET_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://qsip:qsip@localhost:5432/qsip
REDIS_URL=redis://localhost:6379/0

# ── Validation Pipeline ───────────────────────────────────────
FUZZING_ITERATIONS=10000
REGRESSION_TIMEOUT_SEC=120
STATIC_ANALYSIS_DEPTH=5
FUZZING_ENABLED=true

# ── Security ──────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
